    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-5-5",
          "mode": "list",
          "cachedResultName": "claude-haiku-5-5"
        },
        "messages": {
          "values": [
            {
              "content": "=CUSTOMER CONTEXT:\n{{ $(\"Supabase - Find Customer\").item.json.id ? \"Existing customer. Name: \" + $(\"Supabase - Find Customer\").item.json.name + \". Type: \" + $(\"Supabase - Find Customer\").item.json.customer_type + \".\" : \"No customer record found (new or unknown customer).\" }}\n\nEMAIL:\nFrom: {{ $(\"Extract Customer Request\").item.json.customer_name }} <{{ $(\"Extract Customer Request\").item.json.customer_email }}>\nSubject: {{ $(\"Extract Customer Request\").item.json.subject }}\nBody: {{ $(\"Extract Customer Request\").item.json.body }}"
            }
          ]
        },
        "options": {
          "system": "You are a customer support triage assistant. Read the customer email and customer context, then reply with ONE JSON object and nothing else (no markdown, no code fences). Required keys and allowed values: - \"intent\": one of \"order_status\", \"refund_request\", \"product_question\", \"complaint\", \"other\" - \"priority\": one of \"low\", \"medium\", \"high\", \"urgent\" - \"sentiment\": one of \"positive\", \"neutral\", \"negative\" - \"summary\": string, max 2 sentences - \"recommended_action\": string, one clear next step - \"requires_human\": boolean. Use true for refund requests, complaints, angry or urgent customers, legal/safety topics, VIP customers with problems, or when you are unsure. Use false only for simple questions or status requests that a polite reply can fully handle. - \"missing_information\": string describing missing information (empty string \"\" if nothing is missing) Output must be valid JSON only.",
          "maxTokens": 1024
        }
      },
      "id": "c618efc5-295a-4f4e-89d3-d89e5090a1e5",
      "name": "Claude - Analyze Request",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        816,
        -448
      ],
      "credentials": {
        "anthropicApi": {
          "id": "s7gqCrDHYEIhZijT",
          "name": "ScalePods Info trainee"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\nconst blocks = Array.isArray(raw.content) ? raw.content : [];\nconst text = (blocks.find(c => c.type === 'text') || {}).text || '';\nconst clean = text.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\nlet a;\ntry { a = JSON.parse(clean); } catch (e) { throw new Error('Invalid AI response: not valid JSON. Got: ' + clean.slice(0, 200)); }\nconst intents = ['order_status', 'refund_request', 'product_question', 'complaint', 'other'];\nconst priorities = ['low', 'medium', 'high', 'urgent'];\nconst sentiments = ['positive', 'neutral', 'negative'];\nif (!intents.includes(a.intent)) throw new Error('Invalid AI response: bad intent ' + a.intent);\nif (!priorities.includes(a.priority)) throw new Error('Invalid AI response: bad priority ' + a.priority);\nif (!sentiments.includes(a.sentiment)) throw new Error('Invalid AI response: bad sentiment ' + a.sentiment);\nif (typeof a.requires_human !== 'boolean') throw new Error('Invalid AI response: requires_human must be boolean');\nif (typeof a.summary !== 'string' || typeof a.recommended_action !== 'string') throw new Error('Invalid AI response: summary/recommended_action missing');\nconst missing = Array.isArray(a.missing_information) ? a.missing_information.join(', ') : (typeof a.missing_information === 'string' ? a.missing_information : '');\nconst out = {\n  request_id: $('Supabase - Create Request').item.json.id,\n  intent: a.intent,\n  priority: a.priority,\n  sentiment: a.sentiment,\n  summary: a.summary,\n  recommended_action: a.recommended_action,\n  requires_human: a.requires_human,\n  missing_information: missing,\n  status: a.requires_human ? 'waiting_for_human' : 'processing',\n  updated_at: new Date().toISOString(),\n};\nconst cust = $('Supabase - Find Customer').item.json;\nif (cust && cust.id) out.customer_id = cust.id;\nreturn { json: out };"
      },
